 "components": {
  "schemas": {
   "ChatIn": {
    "properties": {
     "session_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 64
       },
       {
        "type": "null"
       }
      ],
      "title": "Session Id",
      "description": "없으면 서버가 새로 발급한다"
     },
     "message": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1,
      "title": "Message",
      "examples": [
       "내일 강남에서 2시 이후에 영화 보고 7시 전에 끝내고 싶어"
      ]
     }
    },
    "type": "object",
    "required": [
     "message"
    ],
    "title": "ChatIn"
   },
   "ChatOut": {
    "properties": {
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "run_id": {
      "type": "string",
      "title": "Run Id"
     },
     "intent": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Intent"
     },
     "answer": {
      "type": "string",
      "title": "Answer"
     },
     "conditions": {
      "additionalProperties": true,
      "type": "object",
      "title": "Conditions",
      "default": {}
     },
     "recommendations": {
      "items": {
       "$ref": "#/components/schemas/Recommendation"
      },
      "type": "array",
      "title": "Recommendations",
      "default": []
     },
     "excluded": {
      "items": {
       "$ref": "#/components/schemas/Excluded"
      },
      "type": "array",
      "title": "Excluded",
      "default": []
     },
     "theaters": {
      "items": {
       "$ref": "#/components/schemas/Theater"
      },
      "type": "array",
      "title": "Theaters",
      "default": []
     },
     "replan_count": {
      "type": "integer",
      "title": "Replan Count",
      "default": 0
     },
     "replan_history": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Replan History",
      "default": []
     },
     "notices": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Notices",
      "default": []
     },
     "events": {
      "items": {
       "$ref": "#/components/schemas/Event"
      },
      "type": "array",
      "title": "Events",
      "default": []
     }
    },
    "type": "object",
    "required": [
     "session_id",
     "run_id",
     "intent",
     "answer"
    ],
    "title": "ChatOut"
   },
   "Event": {
    "properties": {
     "seq": {
      "type": "integer",
      "title": "Seq"
     },
     "event": {
      "type": "string",
      "title": "Event"
     },
     "ts": {
      "type": "string",
      "title": "Ts"
     },
     "payload": {
      "additionalProperties": true,
      "type": "object",
      "title": "Payload"
     }
    },
    "type": "object",
    "required": [
     "seq",
     "event",
     "ts",
     "payload"
    ],
    "title": "Event",
    "description": "실행 과정 패널에 그릴 이벤트 한 건 (F3019). session_id·run_id는 ChatOut에 한 번만 둔다."
   },
   "Excluded": {
    "properties": {
     "movie_nm": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Movie Nm"
     },
     "code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Code"
     },
     "reason": {
      "type": "string",
      "title": "Reason"
     }
    },
    "type": "object",
    "required": [
     "reason"
    ],
    "title": "Excluded",
    "description": "판단에서 뺀 영화와 사유 (F3003, F3011)."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Health": {
    "properties": {
