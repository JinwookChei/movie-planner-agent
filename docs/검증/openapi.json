    "type": "object",
    "required": [
     "movie_nm",
     "watch_date",
     "start_time",
     "end_time"
    ],
    "title": "PlanIn"
   },
   "PlanOut": {
    "properties": {
     "movie_nm": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "title": "Movie Nm",
      "examples": [
       "폭설"
      ]
     },
     "watch_date": {
      "type": "string",
      "format": "date",
      "title": "Watch Date",
      "examples": [
       "2026-11-21"
      ]
     },
     "start_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "title": "Start Time",
      "examples": [
       "14:30"
      ]
     },
     "end_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "title": "End Time",
      "examples": [
       "14:30"
      ]
     },
     "theater": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 200
       },
       {
        "type": "null"
       }
      ],
      "title": "Theater",
      "examples": [
       "CGV 강남"
      ]
     },
     "memo": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 500
       },
       {
        "type": "null"
       }
      ],
      "title": "Memo"
     },
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "created_at": {
      "type": "string",
      "title": "Created At"
     },
     "updated_at": {
      "type": "string",
      "title": "Updated At"
     }
    },
    "type": "object",
    "required": [
     "movie_nm",
     "watch_date",
     "start_time",
     "end_time",
     "id",
     "created_at",
     "updated_at"
    ],
    "title": "PlanOut"
   },
   "PlanSaved": {
    "properties": {
     "plan": {
      "$ref": "#/components/schemas/PlanOut"
     },
     "overlaps": {
      "items": {
       "$ref": "#/components/schemas/PlanOut"
      },
      "type": "array",
      "title": "Overlaps"
     }
    },
    "type": "object",
    "required": [
     "plan",
     "overlaps"
    ],
    "title": "PlanSaved",
    "description": "저장·수정 결과. 겹쳐도 저장은 하고, 겹치는 계획을 함께 알린다 (F3015)."
   },
   "Recommendation": {
    "properties": {
     "movie_nm": {
      "type": "string",
      "title": "Movie Nm"
     },
     "show_tm": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Show Tm"
     },
     "need_min": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
