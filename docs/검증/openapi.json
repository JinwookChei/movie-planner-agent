    "properties": {
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "started_at": {
      "type": "string",
      "title": "Started At"
     },
     "event_count": {
      "type": "integer",
      "title": "Event Count"
     },
     "first_message": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "First Message"
     }
    },
    "type": "object",
    "required": [
     "session_id",
     "started_at",
     "event_count",
     "first_message"
    ],
    "title": "LogSummary"
   },
   "PlanIn": {
    "properties": {
     "movie_nm": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "title": "Movie Nm",
      "examples": [
       "폭설"
      ]
     },
     "watch_date": {
      "type": "string",
      "format": "date",
      "title": "Watch Date",
      "examples": [
       "2026-11-21"
      ]
     },
     "start_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "title": "Start Time",
      "examples": [
       "14:30"
      ]
     },
     "end_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "title": "End Time",
      "examples": [
       "14:30"
      ]
     },
     "theater": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 200
       },
       {
        "type": "null"
       }
      ],
      "title": "Theater",
      "examples": [
       "CGV 강남"
      ]
     },
     "memo": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 500
       },
       {
        "type": "null"
       }
      ],
      "title": "Memo"
