     },
     "reason": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Reason"
     },
     "source": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source"
     }
    },
    "type": "object",
    "required": [
     "movie_nm",
     "fit"
    ],
    "title": "Recommendation",
    "description": "judge가 판단한 영화 한 편. 화면의 [저장] 버튼이 이 값으로 PlanIn을 만든다."
   },
   "Theater": {
    "properties": {
     "name": {
