    "type": "object",
    "required": [
     "keys",
     "log_fail_test"
    ],
    "title": "Health"
   },
   "LogEvent": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "run_id": {
      "type": "string",
      "title": "Run Id"
     },
     "seq": {
      "type": "integer",
      "title": "Seq"
     },
     "event": {
      "type": "string",
      "title": "Event"
     },
     "ts": {
      "type": "string",
      "title": "Ts"
     },
     "payload": {
      "additionalProperties": true,
      "type": "object",
      "title": "Payload"
     }
    },
    "type": "object",
    "required": [
     "id",
     "session_id",
     "run_id",
     "seq",
     "event",
     "ts",
     "payload"
    ],
    "title": "LogEvent"
   },
